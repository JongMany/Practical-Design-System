{
  "$schema": "https://design-tokens.org/schemas/aliases.json",
  "color": {
    "raw": {
      "brand_500": { "value": "#5B8DEF" },
      "gray_900": { "value": "#0F172A" },
      "gray_50": { "value": "#F8FAFC" }
    },
    "semantic": {
      "fg/default": { "value": "{color.raw.gray_900}" },
      "bg/surface": { "value": "{color.raw.gray_50}" },
      "accent/brand": { "value": "{color.raw.brand_500}" }
    },
    "component": {
      "button/primary/bg": { "value": "{color.semantic.accent/brand}" },
      "button/primary/fg": { "value": "{color.semantic.fg/default}" }
    }
  },
  "radius": {
    "raw": { "4": { "value": "4px" }, "8": { "value": "8px" } },
    "semantic": { "control": { "value": "{radius.raw.8}" } }
  },
  "space": {
    "raw": { "2": { "value": "8px" }, "3": { "value": "12px" } },
    "semantic": {
      "control/padding-x": { "value": "{space.raw.3}" },
      "control/padding-y": { "value": "{space.raw.2}" }
    }
  }
}
