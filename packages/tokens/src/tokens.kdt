/* =========================
   4) SEMANTIC (FG/BG/STROKE 등)
   ========================= */
/* ---- LIGHT ---- */
$semantic.color.fg.neutral                -> $scale(theme=light).color.gray-1000
$semantic.color.fg.placeholder            -> $scale(theme=light).color.gray-600
$semantic.color.fg.disabled               -> $scale(theme=light).color.gray-500
$semantic.color.fg.brand                  -> $scale(theme=light).color.carrot-600
$semantic.color.fg.informative            -> $scale(theme=light).color.blue-700
