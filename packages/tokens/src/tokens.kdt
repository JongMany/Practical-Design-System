%KDT:scale(theme=light,contrast=*)

/* =========================
   0) STATIC / PLATFORM
   ========================= */
$static.color.white -> #ffffff
$static.color.black -> #000000

$static.dimension.safe-area-top -> 0px
$static.dimension.safe-area-bottom -> 0px
$semantic.platform.safe-area.top    -> $static.dimension.safe-area-top
$semantic.platform.safe-area.bottom -> $static.dimension.safe-area-bottom
$semantic.platform.safe-area.top    ?? env(constant/env)는 런타임에서 해석

/* iOS 폰트 스케일 한계 */
$static.font-scaling.multiplier.default -> 1
$static.font-scaling.limit.font-size.min -> 0.8
$static.font-scaling.limit.font-size.max -> 1.5
$static.font-scaling.limit.line-height.min -> 0.8
$static.font-scaling.limit.line-height.max -> 1.5
$scale(platform=ios).font-scaling.limit.font-size.max -> 1.35
$scale(platform=ios).font-scaling.limit.line-height.max -> 1.35
$scale(platform=ios,font-scaling=enabled).font-scaling.multiplier -> 0.9412

/* =========================
   1) DIMENSION / RADIUS / DURATION / TIMING
   ========================= */
/* spacing scale (px) */
$scale.dimension.x0-5  -> 2px
$scale.dimension.x1    -> 4px
$scale.dimension.x1-5  -> 6px
$scale.dimension.x2    -> 8px
$scale.dimension.x2-5  -> 10px
$scale.dimension.x3    -> 12px
$scale.dimension.x3-5  -> 14px
$scale.dimension.x4    -> 16px
$scale.dimension.x4-5  -> 18px
$scale.dimension.x5    -> 20px
$scale.dimension.x6    -> 24px
$scale.dimension.x7    -> 28px
$scale.dimension.x8    -> 32px
$scale.dimension.x9    -> 36px
$scale.dimension.x10   -> 40px
$scale.dimension.x12   -> 48px
$scale.dimension.x13   -> 52px
$scale.dimension.x14   -> 56px
$scale.dimension.x16   -> 64px

/* radius */
$scale.radius.r0-5 -> 2px
$scale.radius.r1   -> 4px
$scale.radius.r1-5 -> 6px
$scale.radius.r2   -> 8px
$scale.radius.r2-5 -> 10px
$scale.radius.r3   -> 12px
$scale.radius.r3-5 -> 14px
$scale.radius.r4   -> 16px
$scale.radius.r5   -> 20px
$scale.radius.r6   -> 24px
$scale.radius.full -> 9999px

/* duration */
$scale.duration.d1 -> 50ms
$scale.duration.d2 -> 100ms
$scale.duration.d3 -> 150ms
$scale.duration.d4 -> 200ms
$scale.duration.d5 -> 250ms
$scale.duration.d6 -> 300ms

/* timing function */
$scale.timing.linear             -> cubic-bezier(0,0,1,1)
$scale.timing.easing             -> cubic-bezier(.35,0,.35,1)
$scale.timing.enter              -> cubic-bezier(0,0,.15,1)
$scale.timing.exit               -> cubic-bezier(.35,0,1,1)
$scale.timing.enter-expressive   -> cubic-bezier(.03,.4,.1,1)
$scale.timing.exit-expressive    -> cubic-bezier(.35,0,.95,.55)

/* =========================
   2) TYPOGRAPHY SCALE
   ========================= */
$scale.font-weight.regular  -> regular
$scale.font-weight.medium   -> medium
$scale.font-weight.bold     -> bold
$static.font-family.system  -> "ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Noto Sans, sans-serif"

/* static steps (px 기반) */
$scale.font-size.t1-static  -> 11px
$scale.font-size.t2-static  -> 12px
$scale.font-size.t3-static  -> 13px
$scale.font-size.t4-static  -> 14px
$scale.font-size.t5-static  -> 16px
$scale.font-size.t6-static  -> 18px
$scale.font-size.t7-static  -> 20px
$scale.font-size.t8-static  -> 22px
$scale.font-size.t9-static  -> 24px
$scale.font-size.t10-static -> 26px

$scale.line-height.t1-static  -> 15px
$scale.line-height.t2-static  -> 16px
$scale.line-height.t3-static  -> 18px
$scale.line-height.t4-static  -> 19px
$scale.line-height.t5-static  -> 22px
$scale.line-height.t6-static  -> 24px
$scale.line-height.t7-static  -> 27px
$scale.line-height.t8-static  -> 30px
$scale.line-height.t9-static  -> 32px
$scale.line-height.t10-static -> 35px

/* clamp 계수(런타임 계산용) */
$static.typography.limit.font-size.min   -> 0.8
$static.typography.limit.font-size.max   -> 1.5
$static.typography.limit.line-height.min -> 0.8
$static.typography.limit.line-height.max -> 1.5

/* =========================
   3) PALETTES (LIGHT / DARK)
   ========================= */
