$semantic.color.bg.neutral.weak:pressed   -> $scale(theme=dark).color.gray-400
$semantic.color.bg.overlay-muted          -> $static.color.black-alpha-500
$semantic.color.bg.positive.weak          -> $scale(theme=dark).color.green-100
$semantic.color.bg.positive.solid         -> $scale(theme=dark).color.green-500
$semantic.color.bg.positive.solid:pressed -> $scale(theme=dark).color.green-600
$semantic.color.bg.positive.weak:pressed  -> $scale(theme=dark).color.green-200
$semantic.color.bg.warning.weak           -> $scale(theme=dark).color.yellow-100
$semantic.color.bg.warning.solid          -> $scale(theme=dark).color.yellow-800
$semantic.color.bg.warning.solid:pressed  -> $scale(theme=dark).color.yellow-900
$semantic.color.bg.warning.weak:pressed   -> $scale(theme=dark).color.yellow-200

$semantic.color.stroke.brand.weak         -> $scale(theme=dark).color.carrot-300
$semantic.color.stroke.brand.solid        -> $scale(theme=dark).color.carrot-700
$semantic.color.stroke.critical.weak      -> $scale(theme=dark).color.red-300
$semantic.color.stroke.critical.solid     -> $scale(theme=dark).color.red-700
$semantic.color.stroke.informative.weak   -> $scale(theme=dark).color.blue-300
$semantic.color.stroke.informative.solid  -> $scale(theme=dark).color.blue-700
$semantic.color.stroke.neutral.contrast   -> $scale(theme=dark).color.gray-1000
$semantic.color.stroke.neutral.solid      -> $scale(theme=dark).color.gray-800
$semantic.color.stroke.neutral.weak       -> $scale(theme=dark).color.gray-400
$semantic.color.stroke.neutral.muted      -> $static.color.white-alpha-100
$semantic.color.stroke.neutral.subtle     -> $static.color.white-alpha-50
$semantic.color.stroke.positive.weak      -> $scale(theme=dark).color.green-300
$semantic.color.stroke.positive.solid     -> $scale(theme=dark).color.green-700
$semantic.color.stroke.warning.weak       -> $scale(theme=dark).color.yellow-300
$semantic.color.stroke.warning.solid      -> $scale(theme=dark).color.yellow-700

/* =========================
   5) SEMANTIC – TYPOGRAPHY PRESETS
   ========================= */
$semantic.typography.body.font-family -> $static.font-family.system
$semantic.typography.body.font-size   -> $scale.font-size.t5-static
$semantic.typography.body.line-height -> $scale.line-height.t5-static
$semantic.typography.body.font-weight -> $scale.font-weight.regular
$semantic.typography.body.color       -> $semantic.color.fg.neutral

$semantic.typography.caption.font-family -> $static.font-family.system
$semantic.typography.caption.font-size   -> $scale.font-size.t3-static
$semantic.typography.caption.line-height -> $scale.line-height.t3-static
$semantic.typography.caption.font-weight -> $scale.font-weight.medium
$semantic.typography.caption.color       -> $semantic.color.fg.neutral-subtle

$semantic.typography.h1.font-family -> $static.font-family.system
$semantic.typography.h1.font-size   -> $scale.font-size.t9-static
$semantic.typography.h1.line-height -> $scale.line-height.t9-static
$semantic.typography.h1.font-weight -> $scale.font-weight.bold
$semantic.typography.h1.color       -> $semantic.color.fg.neutral

/* =========================
   6) COMPONENT HOOKS (예시)
   ========================= */
$semantic.component.button.primary.bg             -> $semantic.color.bg.brand.solid
$semantic.component.button.primary.bg:hover       -> $scale(theme=light).color.carrot-700
$semantic.component.button.primary.bg:hover       -> $scale(theme=dark).color.carrot-800
$semantic.component.button.primary.fg             -> $static.color.white
$semantic.component.button.primary.fg:dark        -> $static.color.white

$semantic.component.field.bg                      -> $semantic.color.bg.layer.fill
$semantic.component.field.bd                      -> $semantic.color.stroke.neutral.weak
$semantic.component.field.fg                      -> $semantic.color.fg.neutral
$semantic.component.field.placeholder             -> $semantic.color.fg.placeholder
$semantic.component.field.bd:focus                -> $semantic.color.stroke.brand.solid
$semantic.component.overlay.scrim                 -> $static.color.black
$semantic.component.overlay.scrim-opacity         -> 45%